# Database Configuration
spring.datasource.url=${DB_URL}
spring.datasource.username=${DB_USERNAME}
spring.datasource.password=${DB_PASSWORD}
# Hibernate DDL - set to 'validate' in production when using Flyway
# 'update' is acceptable for development but Flyway migrations are preferred
spring.jpa.hibernate.ddl-auto=update

# Flyway Configuration
spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration
spring.flyway.baselineOnMigrate=true
spring.flyway.baselineVersion=0
spring.flyway.cleanDisabled=true
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect

# JWT Configuration
jwt.secret=${JWT_SECRET}
jwt.expiration=${JWT_EXPIRATION}

# CORS Configuration
# Use comma-separated values for multiple origins. Use '*' for all origins (development only).
# Production: set specific origins like 'https://your-frontend-domain.com'
app.cors.allowed-origins=*

# Swagger/OpenAPI Configuration
springdoc.api-docs.path=/v3/api-docs
springdoc.swagger-ui.path=/swagger-ui.html

# Swagger Security
# Set to 'true' (default) to require ADMIN role for Swagger UI access (production).
# Set to 'false' to allow public access to Swagger UI (development).
app.swagger.secured=true

# Jackson Configuration
spring.jackson.deserialization.fail-on-null-for-primitives=false

# Actuator Configuration
management.endpoints.web.exposure.include=health,info,metrics,prometheus
management.endpoint.health.show-details=when-authorized
management.endpoint.health.show-components=always
management.health.db.enabled=true
management.health.diskspaces.enabled=true
management.info.env.enabled=true
management.info.java.enabled=true
management.info.os.enabled=true
info.app.name=${spring.application.name:app}
info.app.version=@project.version@
info.app.description=Pharmacy/Retail POS System
info.app.java.version=@java.version@

# Logging Configuration
# For detailed config see logback-spring.xml
logging.config=classpath:logback-spring.xml
